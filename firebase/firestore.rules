rules_version = '2';
// ============================================================================
//  Firestore Security Rules — POS Pro
//  Modelo de permisos basado en roles (admin / encargado / cajero).
//  El rol se lee desde el documento users/{uid} del propio usuario y
//  SOLO es válido si el usuario está activo (A2).
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc()  { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile(){ return signedIn()
      && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isActive() { return hasProfile() && userDoc().active == true; }
    // Sin perfil o inactivo => rol 'none' (sin permisos).
    function role()     { return isActive() ? userDoc().role : 'none'; }
    function isAdmin()  { return role() == 'admin'; }
    function isStaff()  { return role() == 'admin' || role() == 'encargado'; }
    function anyRole()  { return role() in ['admin','encargado','cajero']; }
    function changedKeys(){ return request.resource.data.diff(resource.data).affectedKeys(); }

    // --- Usuarios: cada quien lee su doc; admin administra todos ---
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, delete: if isAdmin();
      // admin edita cualquiera; el propio usuario solo toca su lastLogin.
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && changedKeys().hasOnly(['lastLogin']));
    }

    // --- Catálogo: lectura para todo el personal; escritura staff ---
    // El cajero solo puede DESCONTAR stock (venta): stock + updatedAt y nunca aumentarlo.
    match /products/{id} {
      allow read: if anyRole();
      allow create, delete: if isStaff();
      allow update: if isStaff()
        || (anyRole()
            && changedKeys().hasOnly(['stock','updatedAt'])
            && request.resource.data.stock <= resource.data.stock);
    }
    match /categories/{id}    { allow read: if anyRole(); allow write: if isStaff(); }
    match /subcategories/{id} { allow read: if anyRole(); allow write: if isStaff(); }

    // --- Ventas: crea cualquier rol operativo (venta propia y completada) ---
    match /sales/{id} {
      allow read: if anyRole();
      allow create: if anyRole()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'completada';
      allow update: if isStaff();   // anulación / corrección
      allow delete: if isAdmin();
    }
    match /payments/{id} {
      allow read: if anyRole(); allow create: if anyRole();
      allow update, delete: if isStaff();
    }

    // --- Devoluciones (C3): solo staff (admin/encargado) registra devoluciones ---
    // Son inmutables una vez creadas (igual que la auditoría).
    match /returns/{id} {
      allow read: if anyRole();
      allow create: if isStaff()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // --- Compras y proveedores: staff ---
    match /purchases/{id}  { allow read: if anyRole(); allow write: if isStaff(); }
    match /suppliers/{id}  { allow read: if anyRole(); allow write: if isStaff(); }

    // --- Clientes y cuenta corriente ---
    // Cajero: crear cliente y actualizar SOLO saldo (balance) + updatedAt.
    // Límite de crédito y datos personales => staff. Borrar => staff.
    match /clients/{id} {
      allow read: if anyRole();
      allow create: if anyRole();
      allow update: if isStaff()
        || (anyRole() && changedKeys().hasOnly(['balance','updatedAt']));
      allow delete: if isStaff();
    }
    match /accountsReceivable/{id} { allow read: if anyRole(); allow create, update: if anyRole(); allow delete: if isAdmin(); }
    match /accountsPayable/{id}    { allow read: if anyRole(); allow write: if isStaff(); }

    // --- Stock y caja ---
    match /stockMovements/{id} { allow read: if anyRole(); allow create: if anyRole(); allow update, delete: if isAdmin(); }
    match /cashRegisters/{id}  { allow read: if anyRole(); allow create, update: if anyRole(); allow delete: if isAdmin(); }
    match /cashMovements/{id}  { allow read: if anyRole(); allow create, update: if anyRole(); allow delete: if isAdmin(); }
    match /expenses/{id}       { allow read: if anyRole(); allow write: if isStaff(); }

    // --- Numeradores y resúmenes diarios (A3 / B1) ---
    match /counters/{id}   { allow read: if anyRole(); allow create, update: if anyRole(); allow delete: if isAdmin(); }
    match /dailyStats/{id} { allow read: if anyRole(); allow create, update: if anyRole(); allow delete: if isAdmin(); }

    // --- Auditoría: cada quien agrega su propio registro; solo admin lee ---
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if anyRole() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // --- Configuración y plantillas: lectura todos, escritura admin ---
    match /settings/{id}         { allow read: if anyRole(); allow write: if isAdmin(); }
    match /ticketTemplates/{id}  { allow read: if anyRole(); allow write: if isAdmin(); }
    match /invoiceTemplates/{id} { allow read: if anyRole(); allow write: if isAdmin(); }

    // Todo lo no declarado queda denegado por defecto.
    match /{document=**} { allow read, write: if false; }
  }
}
